// IfáScript Ω — Grammar v0.2.1
// Ògún's Forge: pest format, parses `invoke` statements
// Path: src/compiler/grammar.pest

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" | "//" ~ (!"\n" ~ ANY)* }

// === Reserved keywords — prevent future collisions ===
// Keywords must be followed by non-alphanumeric to avoid matching prefixes in identifiers
reserved_keyword = _{
    ("ritual" | "odù" | "witness" | "invoke" | "settle" | "canon" |
     "mentalism" | "correspondence" | "vibration" | "polarity" |
     "rhythm" | "cause_effect" | "gender" | "with" |
     "let" | "if" | "else" | "return") ~ !(ASCII_ALPHANUMERIC | "_")
}

// === Identifiers: cannot start with a reserved keyword ===
ident  = @{ !reserved_keyword ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

string = ${ "\"" ~ (("\\\"") | (!"\"" ~ ANY))* ~ "\"" }
number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

// === Hermetic principles (silent — folds into gate_spec) ===
hermetic_principle = _{
    "mentalism" | "correspondence" | "vibration" |
    "polarity"  | "rhythm"        | "cause_effect" | "gender"
}

// === Structural rules (appear in parse tree) ===
gate_spec    = { hermetic_principle ~ ":" ~ number }
witness_spec = { "witness" ~ number }
sabbath_spec = { "Saturday" | "any" | string }

// === Invocation ===
invocation = {
    "invoke" ~ ident ~
    ("with" ~ gate_spec)? ~
    witness_spec?          ~
    ("settle" ~ sabbath_spec)? ~
    ";"
}

// === Definitions (v0.3): odù bindings and rituals ===
// Òdù names are capitalised (Ogbe, Oyeku, …); prescriptions are named actions
// with optional literal arguments.
odu_name     = @{ ASCII_ALPHA_UPPER ~ (ASCII_ALPHANUMERIC | "_")* }
literal      = { string | number | ident }
literal_list = { literal ~ ("," ~ literal)* }
prescription = { ident ~ ("(" ~ literal_list? ~ ")")? ~ ";" }

// odù Ogbe<binding> { prescription* }
odu_def = {
    "odù" ~ odu_name ~ "<" ~ ident ~ ">" ~
    "{" ~ prescription* ~ "}"
}

// ritual name(params) { statement* }
// Statements: prescriptions, let bindings, if conditionals, returns
type_expr  = { "u8" | "u16" | "u32" | "u64" | "bool" | "string" | ident }
param      = { ident ~ ":" ~ type_expr }
param_list = { param ~ ("," ~ param)* }

// Expressions: literals, identifiers, binary ops, odu literals, function calls
expr_term   = { odu_literal_expr | call_expr | "(" ~ expression ~ ")" | literal | ident }
binary_op   = @{ "+" | "-" | "*" | "/" | "==" | "!=" | "<" | ">" }
expression  = { expr_term ~ (binary_op ~ expr_term)* }

odu_literal_expr = { "@" ~ odu_name ~ ("<" ~ literal ~ ">")? }
call_expr   = { ident ~ "(" ~ (expression ~ ("," ~ expression)*)? ~ ")" }

// Statements
statement = {
    let_stmt | if_stmt | return_stmt | prescription
}

let_stmt    = { "let" ~ ident ~ ":" ~ type_expr ~ "=" ~ expression ~ ";" }
if_stmt     = { "if" ~ expression ~ "{" ~ statement* ~ "}" ~ ("else" ~ "{" ~ statement* ~ "}")? }
return_stmt = { "return" ~ expression? ~ ";" }

ritual_def = {
    "ritual" ~ ident ~ "(" ~ param_list? ~ ")" ~
    "{" ~ statement* ~ "}"
}

// witness name: quorum @"oracle" @"anchor";
// Declares a named witness set — quorum size, oracle endpoint, anchor
// network — that an `invoke ... witness N` clause can be checked against.
witness_def = {
    "witness" ~ ident ~ ":" ~ number ~
    "@" ~ string ~
    "@" ~ string ~
    ";"
}

// === Program ===
program = { SOI ~ (odu_def | ritual_def | witness_def | invocation)* ~ EOI }
